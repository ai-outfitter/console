{
  "name": "@ai-outfitter/console-ui",
  "version": "0.1.0",
  "description": "Reusable Astro components and browser-safe view models for AI Outfitter agent consoles.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-outfitter/console.git",
